ACTION=="add|change", SUBSYSTEM=="scsi_generic", KERNEL=="sg[0-9]*", ATTRS{type}=="1", ENV{ID_SERIAL}=="", IMPORT{program}="/usr/lib/udev/scsi_id --export --whitelisted --device=/dev/$name"
ACTION=="add|change", SUBSYSTEM=="scsi_generic", KERNEL=="sg[0-9]*", ATTRS{type}=="1", ENV{ID_SERIAL}!="", SYMLINK+="lto-archiver-scsi-$env{ID_SERIAL}", GROUP="tape", MODE="0660", TAG+="systemd"
